# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgres://shop_app:CHANGE_ME@localhost:5432/smartphone_shop
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_32_CHARS_MIN
# Enables POST /api/test/reset (drops and reseeds the database). Local only.
ENABLE_TEST_RESET=true
