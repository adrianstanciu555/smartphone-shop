{
  "name": "smartphone-shop-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript end-to-end tests for the Smartphone Shop frontend",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:mocks": "playwright test tests/mocks",
    "report": "playwright show-report",
    "allure": "allure run -- node node_modules/@playwright/test/cli.js test",
    "allure:generate": "allure generate --clean",
    "allure:open": "allure open allure-report",
    "allure:watch": "allure watch allure-results",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "allure": "^3.33.0",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
